# Local service configuration. Source checkouts copy this file to backend/.env;
# the Windows portable build publishes it as .env beside DirectorStudio.exe.
DS_COMFY_BASE_URL=http://127.0.0.1:8188
DS_HOST=127.0.0.1
DS_PORT=8790
# Source development only. Deployed startup keeps one process without reload.
DS_RELOAD=false
# Optional absolute directory for persistent application data.
# DS_DATA_DIR=/path/to/director-data

# Director provider: ollama for a local installation, openai_compatible for LiteLLM.
DS_LLM_PROVIDER=ollama
# For LiteLLM use its OpenAI API root, including /v1.
# DS_LLM_BASE_URL=http://100.124.186.11:4000/v1
# Supply the real key only in the private runtime env file.
# DS_LLM_API_KEY=
# No model is selected automatically. Set an exact served ID or use the picker.
DS_LLM_MODEL=
# Only models verified for images on this endpoint belong in this CSV allowlist.
DS_LLM_VISION_MODELS=
# Verified kasari-flash full Director planning needs an explicit larger budget.
# DS_DIRECTOR_NUM_PREDICT=8192
# Defaults: openai_compatible => independent; ollama => exclusive.
# Independent mode never evicts LLM/Comfy models and permits chat during renders.
# DS_VRAM_POLICY=independent
DS_OLLAMA_BASE_URL=http://127.0.0.1:11434

DS_POLL_INTERVAL_SEC=1.5
DS_JOB_TIMEOUT_SEC=1800
DS_MAX_UPLOAD_MB=20

# H3 video provider: local (ComfyUI through official Comfy MCP, default) or
# minimax (official V2 API).
DS_H3_PROVIDER=local
# MCP transports every local ComfyUI image/video workflow. The default commands
# are installed by backend/requirements.txt.
# DS_COMFY_MCP_COMMAND=comfy-mcp
# DS_COMFY_MCP_ARGS=
# DS_COMFY_MCP_COMFY_BIN=comfy
# Set the secret only in backend/.env or as MINIMAX_API_KEY; never commit it.
# MINIMAX_API_KEY=your-secret-key
# DS_H3_MINIMAX_API_KEY=your-secret-key
DS_H3_MINIMAX_MODEL=MiniMax-H3
DS_H3_MINIMAX_RESOLUTION=768P
DS_H3_MINIMAX_POLL_INTERVAL_SEC=10
DS_H3_MINIMAX_TIMEOUT_SEC=3600
DS_H3_MINIMAX_MAX_GET_RETRIES=3
DS_H3_MINIMAX_RETRY_DELAY_SEC=2
